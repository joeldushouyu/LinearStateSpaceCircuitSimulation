      SrcTerminal   1
      DstComponent  "Lr"
      DstTerminal   1
    }
  }
  Script {
    Name          "Script"
    Script        "k = plecs('get', 'Full-bridge-llc', 'SystemState')\nvec = p"
"lecs('get', 'Full-bridge-llc', 'StateSpaceOrder');\nplecs('set', 'Full-bridge"
"-llc', 'SwitchVector', [ 1 0 0 1 0 0 0 0]); \nmodel_TFTF= plecs('get', 'Full-"
"bridge-llc', 'Topology');\nsave full-bridge-llc.mat"
  }
}

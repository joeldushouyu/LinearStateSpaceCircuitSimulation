
MEMORY
{
   program (RX) : ORIGIN = 0, LENGTH = 0x0020000
   data (!RX) : ORIGIN = 0x77400, LENGTH = 0x8C00
}
ENTRY(__start)
SECTIONS
{
  . = 0x0;
  .text : {
     /* the __start symbol has to come at address zero. */
     *crt0.o(.text*)
     _ctors_start = .;
     _init_array_start = .;
     KEEP(SORT(*.init_array))
     _ctors_end = .;
     _init_array_end = .;
     _dtors_start = .;
     _dtors_end = .;
     *(.text*)
  } > program
  .data : {
     *(.data*)
     *(.rodata*)
  } > data
  .comment : {
     *(.comment*)
  }
  .symtab : {
     *(.symtab)
  }
  .shstrtab : {
     *(.shstrtab)
  }
  .strtab : {
     *(.strtab)
  }

. = 0x70000;
_sp_start_value_DM_stack = .;
. += 0x400; /* stack */
/* No tile with memory exists to the south. */
. = 0x40000;
. += 0x10000;
. = 0x50400;
in_buffer_0 = .;
. += 0xF60;
. = 0x51380;
switch_diode_buffer = .;
. += 0x1C00;
. = 0x52F80;
A_B_C_D_buffer = .;
. += 0x5400;
. = 0x58380;
out_buffer_0 = .;
. += 0x7B00;
. = 0x70400;
switch_diode_buffer_debug = .;
. += 0x1C00;
. = 0x72000;
A_B_C_D_debug_buffer = .;
. += 0x5400;
  .bss : { *(.bss*) } > data
}
INPUT(passThrough.o)
PROVIDE(main = core_1_2);
